organized_figures/

# Unreferenced intermediate table left at the repository root.
/Megakaryocyte_neighbors15micron.txt

# Figure output written by the notebooks (requirements.py defines media_dir here).
media/

# Local copies of the large primary datasets (Xenium / CITE-seq AnnData objects). Not
# distributed with the repository -- see the Data section of README.md. Anchored to the
# repository root so that the tracked R input tables in R_scripts/data/ are NOT ignored.
/data/

